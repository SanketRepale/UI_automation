# LLM Settings (Supports Gemini, OpenAI-compatible, and Anthropic)
# To use Gemini, you only need to set GEMINI_API_KEY (or LLM_API_KEY) with LLM_PROVIDER=gemini:
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
LLM_API_KEY=
TARGET_URL=
AUTHENTICATION_TYPE=
TARGET_ENVIRONMENT=
TARGET_USERNAME=
TARGET_PASSWORD=
USERNAME_FIELD_LABEL=
PASSWORD_FIELD_LABEL=
LOGIN_BUTTON_LABEL=
BROWSER=
HEADLESS=
TIMEOUT_MS=10000
SCREENSHOT_ON_PASS=true
SCREENSHOT_ON_FAILURE=true
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
EXECUTION_ENABLED=true
