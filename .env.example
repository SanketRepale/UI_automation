# =============================================================================
# Fieldnotes QA - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Settings (Supports Gemini, OpenAI-compatible, and Anthropic)
# -----------------------------------------------------------------------------
# Provider: gemini | openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# For Gemini, use:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-3.7-flash
# GEMINI_API_KEY=your-gemini-api-key

# For Anthropic, use:
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=your-anthropic-api-key

# -----------------------------------------------------------------------------
# Target Application Settings
# -----------------------------------------------------------------------------
TARGET_URL=https://your-app.example.com
AUTHENTICATION_TYPE=Username & Password
TARGET_ENVIRONMENT=QA
TARGET_USERNAME=
TARGET_PASSWORD=
USERNAME_FIELD_LABEL=Email
PASSWORD_FIELD_LABEL=Password
LOGIN_BUTTON_LABEL=Sign In

# -----------------------------------------------------------------------------
# Browser Settings
# -----------------------------------------------------------------------------
BROWSER=chromium
HEADLESS=true
TIMEOUT_MS=10000
SCREENSHOT_ON_PASS=true
SCREENSHOT_ON_FAILURE=true

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# API Bearer token for authentication (required in production)
API_AUTH_TOKEN=generate-a-secure-random-token-here

# CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Execution control
EXECUTION_ENABLED=true

# Environment (development | staging | production)
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Database & Queue (Production)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Redis connection string for job queue
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Local Development Overrides
# -----------------------------------------------------------------------------
# Use SQLite instead of PostgreSQL (development only)
# DATA_DIR=./data

# Vercel deployment marker (set automatically on Vercel)
# VERCEL=1